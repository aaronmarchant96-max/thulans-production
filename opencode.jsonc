{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-luna",
  "small_model": "google/gemini-3.8-flash",
  "tool_output": {
    "max_lines": 250,
    "max_bytes": 16384
  },
  "compaction": {
    "auto": true,
    "tail_turns": 10
  },
  "instructions": [
    "AGENTS.md",
    "TOKEN_SAVERS.md",
    "docs/THULAN_NOVELLA_VOICE_CONTRACT.md",
    "docs/CARDO_STORY_METHOD.md",
    "docs/THULAN_VIOLENCE_DOCTRINE.md",
    "docs/GDR_SLOP.md",
    "docs/NOVELLA_BLUEPRINT.md",
    "docs/STORY_BIBLE.md"
  ],
  "agent": {
    "codex": {
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "edit": "allow"
      }
    },
    "editor": {
      "model": "openai/gpt-5.6-luna",
      "permission": {
        "edit": "allow"
      }
    },
    "agy": {
      "model": "google/gemini-3.8-flash",
      "permission": {
        "edit": "deny"
      }
    },
    "explore": {
      "model": "google/gemini-3.8-flash",
      "permission": {
        "edit": "deny"
      }
    }
  }
}
