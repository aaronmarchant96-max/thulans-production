# Blender working files and recovery copies
*.blend
*.blend1
*.blend2

# Render output and caches
renders/
cache/
__pycache__/
*.pyc

# Editors and operating system
.vscode/
.DS_Store
Thumbs.db

# Audio intermediates (keep masters; not editing backups/peak caches)
assets/audio/Backups/
assets/audio/peaks/

# Donor source archives (keep provenance/license, not the zips)
assets/donors/*/source.zip

# Local AI/agent launchers (may contain API keys — never commit)
run_aider_deepseek.sh
start_varek_ai.sh

# Raw probe dumps (hash-bound JSON is the evidence of record)
evidence/**/probe.json

# Generated render iteration output (keep curated concept sheets + hash-bound JSON;
# route large masters through Git LFS when available)
evidence/**/*.png
assets/art/*.png
assets/audio/The_Song_of_the_Wahlja_Master.wav
